# StudyFlow AI Tutor MVP
APP_ENV=development
MAX_UPLOAD_MB=20
MAX_INPUT_CHARACTERS=60000

# OpenAI Responses API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol

# Hybrid PDF pipeline: text layer -> local OCR -> Vision for selected pages
ENABLE_LOCAL_OCR=true
OCR_LANGUAGES=vie+eng
ENABLE_VISION=true
OPENAI_VISION_MODEL=gpt-5.6-sol
MAX_VISION_PAGES=30
VISION_IMAGE_DETAIL=low
